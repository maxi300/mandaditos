{
  "name": "mandadito-functions",
  "private": true,
  "main": "lib/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "node ../scripts/sync-shared.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "npm run build && firebase deploy --only functions",
    "seed": "npm run build && node lib/scripts/seed.js"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  }
}
