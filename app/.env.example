# Copiá este archivo como .env (en esta misma carpeta "app").
#
# demo     = funciona sin internet ni Firebase, con datos de ejemplo (código de acceso: 123456)
# firebase = usa tu proyecto de Firebase real (llená los datos de abajo)
EXPO_PUBLIC_DATA_SOURCE=demo

# Firebase Console → Configuración del proyecto → Tus apps → App web → Configuración del SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
