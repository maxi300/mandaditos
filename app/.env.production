# Variables para los builds de EAS (APK de prueba y Play Store).
# Este archivo SÍ se sube con el build: el `.env` normal no (está en .gitignore y es para el modo demo).
#
# Estos datos de Firebase NO son secretos: van dentro de la app de todas formas.
# La seguridad la ponen firestore.rules y las Cloud Functions.
#
# Firebase Console → ⚙️ Configuración del proyecto → Tus apps → App web (</>) → Configuración del SDK
EXPO_PUBLIC_DATA_SOURCE=firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
